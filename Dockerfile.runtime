# ==============================================
# 运行时镜像（极简）
#
# 用途：复用 build-fullstack.sh 产出的静态二进制（前端已嵌入），
#       只套一层 alpine，镜像约 20MB，构建只需拉取 alpine 基础层。
#
# 构建：
#   docker build -f Dockerfile.runtime -t file-transfer-go:auth .
#
# 同目录需存在：
#   file-transfer-server-linux-amd64
#   file-transfer-server-linux-arm64
# 构建时按容器自身的 uname -m 自动二选一，
# 不依赖 BuildKit 的 TARGETARCH，老版本 Docker 也能构建。
# ==============================================

FROM alpine:3.18

RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -s /bin/sh appuser

WORKDIR /app

COPY file-transfer-server-linux-amd64 file-transfer-server-linux-arm64 ./

RUN set -eux; \
    case "$(uname -m)" in \
      x86_64|amd64)  BIN=file-transfer-server-linux-amd64 ;; \
      aarch64|arm64) BIN=file-transfer-server-linux-arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    mv "$BIN" server; \
    rm -f file-transfer-server-linux-*; \
    chmod +x server; \
    mkdir -p /app/data; \
    chown -R appuser:appuser /app

ENV DATA_DIR=/app/data

USER appuser

EXPOSE 8080

CMD ["./server"]
